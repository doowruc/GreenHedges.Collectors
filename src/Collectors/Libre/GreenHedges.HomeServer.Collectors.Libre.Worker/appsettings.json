{
  "LibreLinkUp": {
    "Email": "",
    "Password": "",
    "Region": null,
    "Product": "llu.android",
    "Version": "5.0.1"
  },
  "Collector": {
    "PatientId": null,
    "CurrentInterval": "00:01:00",
    "GraphInterval": "00:30:00"
  },
  "Alerts": {
    "ResendApiKey": "",
    "From": "",
    "To": [],
    "StaleAfter": "00:20:00"
  },
  "Heartbeat": {
    "PingUrl": "",
    "Interval": "00:05:00"
  },
  "Backup": {
    "Enabled": true,
    "Directory": "backups",
    "TimeOfDay": "03:30:00",
    "Retain": 7
  },
  "Nightscout": {
    "BaseUrl": "",
    "BatchSize": 500
  },
  "Offsite": {
    "Bucket": "",
    "Region": "",
    "Prefix": "librecollector",
    "StorageClass": "STANDARD",
    "AgePath": "age",
    "CheckInterval": "01:00:00"
  },
  "Archive": {
    "DatabasePath": "librecollector.db"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/librecollector-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ]
  }
}
