@page "/{kind:regex(^(brands|stations)$)}/Merge/{id:int}"
@model VehicleManager.Pages.Places.MergeModel
@{ ViewData["Title"] = $"Merge {Model.Places.Singular}"; }

<h1 class="h3 mb-3">Merge @Model.Places.Singular</h1>
<div class="card shadow-sm"><div class="card-body">
    @if (Model.Targets.Count == 0)
    {
        <p>There are no other @(Model.Places.Singular)s to merge <strong>@Model.Source.FullName</strong> into.</p>
        <a asp-page="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">Back</a>
    }
    else
    {
        <p>
            Move <strong>@Model.Source.FullName</strong>'s @Model.Source.FillUps fill-up(s)
            @if (Model.Source.Stations > 0) { <text>and @Model.Source.Stations station(s)</text> }
            to another @Model.Places.Singular, then delete <strong>@Model.Source.FullName</strong>.
            Use this to combine duplicates, such as a misspelling.
            @if (!Model.Places.HasBrand) { <text>Stations with the same name in both brands are combined.</text> }
        </p>
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="IntoId" class="form-label">Merge into</label>
                    <select asp-for="IntoId" asp-items="Model.Targets" class="form-select">
                        <option value="">— choose —</option>
                    </select>
                    <span asp-validation-for="IntoId" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Merge</button>
                <a asp-page="Index" asp-route-kind="@Model.Kind" class="btn btn-link">Cancel</a>
            </div>
        </form>
    }
</div></div>
