@page "/{kind:regex(^(brands|stations)$)}"
@model VehicleManager.Pages.Places.IndexModel
@{ ViewData["Title"] = Model.Places.Plural; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Places.Plural</h1>
</div>
<p class="text-muted small">
    New @(Model.Places.Singular)s are added by typing them on a fill-up. Merge duplicates (e.g. a misspelling) into the right one;
    only unused @(Model.Places.Singular)s can be deleted.
    @if (Model.Places.HasBrand) { <text>Each station belongs to a brand; one location can have stations for several brands.</text> }
    else { <text>Merging a brand moves its stations too, combining any with the same name.</text> }
</p>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">No @(Model.Places.Singular)s yet. They're added when you record a fill-up.</div>
}
else
{
    <div class="card shadow-sm"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-head">
                <tr>
                    <th>Name</th>
                    @if (Model.Places.HasBrand) { <th>Brand</th> } else { <th class="text-end">Stations</th> }
                    <th class="text-end">Fill-ups</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Rows)
            {
                <tr>
                    <td>@p.Name</td>
                    @if (Model.Places.HasBrand) { <td>@p.Brand</td> } else { <td class="text-end">@p.Stations</td> }
                    <td class="text-end">@p.FillUps</td>
                    <td class="text-end text-nowrap">
                        <a asp-page="Edit" asp-route-kind="@Model.Kind" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-page="Merge" asp-route-kind="@Model.Kind" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Merge into another"><i class="bi bi-sign-merge-left"></i></a>
                        <a asp-page="Delete" asp-route-kind="@Model.Kind" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
}
