@page
@model VehicleManager.Pages.IndexModel
@{ ViewData["Title"] = "Dashboard"; }

<h1 class="h3 mb-3">Dashboard</h1>

@if (Model.Cards.Count == 0)
{
    <div class="card shadow-sm"><div class="card-body">
        <h2 class="h5">Welcome</h2>
        <p class="mb-2">Get started by adding the vehicles you own, then import your historical fuel spreadsheet.</p>
        <a asp-page="/Vehicles/Create" class="btn btn-primary">Add a vehicle</a>
        <a asp-page="/Import/Index" class="btn btn-outline-secondary">Import spreadsheet</a>
    </div></div>
}
else
{
    if (Model.ComingUp.Count > 0)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-body fw-semibold"><i class="bi bi-calendar-event me-2"></i>Coming up</div>
            <ul class="list-group list-group-flush">
            @foreach (var d in Model.ComingUp)
            {
                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span>
                        <strong>@d.Name</strong> ·
                        <a asp-page="/Vehicles/Details" asp-route-id="@d.VehicleId" class="text-decoration-none">@d.VehicleName</a>
                        <span class="reg-plate small ms-1">@d.RegistrationNumber</span>
                    </span>
                    <span class="badge @d.BadgeClass" title="@d.Detail">@d.DateText · @d.When@if (d.DueMileage is { } miles) { <text> · @miles.ToString("N0") mi</text> }</span>
                </li>
            }
            </ul>
        </div>
    }
    <partial name="_PeriodToggle" />
    if (Model.Years.Count > 0)
    {
        <div class="card shadow-sm mb-3" id="spending">
            <div class="card-header bg-body fw-semibold"><i class="bi bi-currency-pound me-2"></i>Fuel spending</div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="period-stats" data-period="12m">
                            <h2 class="h6 text-muted">Each month</h2>
                            <div class="chart-box"><canvas data-spend-chart="@Model.MonthlySpendJson" role="img" aria-label="Fuel spend each month for the last 12 months"></canvas></div>
                        </div>
                        <div class="period-stats" data-period="all">
                            <h2 class="h6 text-muted">Each year</h2>
                            <div class="chart-box"><canvas data-spend-chart="@Model.YearlySpendJson" role="img" aria-label="Fuel spend each year"></canvas></div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h2 class="h6 text-muted">Year on year</h2>
                        <div class="chart-box"><canvas data-spend-trend="@Model.YearOnYearJson" role="img" aria-label="Running total of fuel spend through each year"></canvas></div>
                    </div>
                </div>
                <div class="table-responsive mt-3">
                    <table class="table table-sm table-data mb-0 w-auto">
                        <thead class="table-head"><tr><th>Year</th><th class="text-end">Spent</th><th class="text-end">Change</th><th class="text-end">Fill-Ups</th></tr></thead>
                        <tbody>
                        @foreach (var y in Model.Years)
                        {
                            <tr>
                                <td>@y.Year@if (y.ToDate is { } to) { <span class="text-muted small ms-1">to @to.ToString("d MMM")</span> }</td>
                                <td class="text-end">@y.Total.ToString("C0")</td>
                                <td class="text-end @(y.Change > 0 ? "text-danger" : y.Change < 0 ? "text-success" : null)"
                                    title="@(y.ToDate is { } d ? $"Against {y.Year - 1} up to {d:d MMM}" : null)">@(y.Change?.ToString("+0%;−0%;0%") ?? "–")</td>
                                <td class="text-end">@y.FillUps</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<div class="row g-3">
@foreach (var c in Model.Cards)
{
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <div>
                    <a asp-page="/Vehicles/Details" asp-route-id="@c.Vehicle.Id" class="fw-semibold text-decoration-none">@c.Vehicle.DisplayName</a>
                    <div class="text-muted small">@c.Vehicle.OwnerName</div>
                </div>
                <span class="reg-plate small">@c.Vehicle.RegistrationNumber</span>
            </div>
            <div class="card-body">
                @if (c.DueDates.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-1 mb-3"><partial name="_DueDates" model="c.DueDates" /></div>
                }
                @if (c.Last is null)
                {
                    <p class="text-muted mb-0">No fill-ups yet.</p>
                }
                else
                {
                    @foreach (var (period, summary) in new[] { ("12m", c.Year), ("all", c.AllTime) })
                    {
                        <div class="row text-center g-2 mb-3 period-stats" data-period="@period">
                            <div class="col-4"><div class="stat-card"><div class="label">MPG</div><div class="value">@(summary.AverageMpg?.ToString("0.0") ?? "–")</div></div></div>
                            <div class="col-4"><div class="stat-card"><div class="label">Spent</div><div class="value">@summary.TotalCost.ToString("C0")</div></div></div>
                            <div class="col-4"><div class="stat-card"><div class="label">Odometer</div><div class="value">@(c.AllTime.LatestOdometer?.ToString("N0") ?? "–")</div></div></div>
                        </div>
                    }
                    <p class="small text-muted mb-0">
                        Last fill-up @c.Last.Date.ToString("dd MMM yyyy") (@((DateOnly.FromDateTime(DateTime.Today).DayNumber - c.Last.Date.DayNumber)) days ago):
                        @c.Last.Litres.ToString("0.0") l of @c.Last.Brand at @c.Last.Station, @c.Last.EffectiveCostPerLitre.ToString("C3")/l.
                        @c.AllTime.FillUps fill-ups since @c.AllTime.FirstFillUp?.ToString("MMM yyyy").
                    </p>
                }
            </div>
            <div class="card-footer bg-body">
                <a asp-page="/FuelLog/Create" asp-route-vehicleId="@c.Vehicle.Id" class="btn btn-sm btn-success"><i class="bi bi-fuel-pump me-1"></i>Add fill-up</a>
                <a asp-page="/Vehicles/Services/Create" asp-route-vehicleId="@c.Vehicle.Id" class="btn btn-sm btn-primary"><i class="bi bi-wrench me-1"></i>Add service</a>
                <a asp-page="/Vehicles/Details" asp-route-id="@c.Vehicle.Id" class="btn btn-sm btn-outline-secondary">Details</a>
            </div>
        </div>
    </div>
}
</div>

@section Scripts {
    @if (Model.Years.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.js"></script>
        <script src="~/js/spend-chart.js" asp-append-version="true"></script>
    }
}
