@page
@model VehicleManager.Pages.FuelLog.IndexModel
@{ ViewData["Title"] = "Fuel Log"; }

@section Styles { <partial name="_DataTableStyles" /> }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Fuel Log</h1>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="vehicleId" asp-items="Model.VehicleOptions" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="">All vehicles</option>
            </select>
            <select name="year" asp-items="Model.YearOptions" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="">All years</option>
            </select>
        </form>
        @* For the vehicle the log is showing, if it's showing one. *@
        <a asp-page="Create" asp-route-vehicleId="@Model.VehicleId" class="btn btn-sm btn-success text-nowrap"><i class="bi bi-fuel-pump me-1"></i>Add fill-up</a>
    </div>
</div>

<div class="mb-4"><partial name="_StatCards" model="Model.Summary" /></div>

<div class="card shadow-sm">
    @if (Model.Entries.Count == 0)
    {
        <div class="card-body text-muted">No fill-ups match.</div>
    }
    else
    {
        <div class="card-body py-2">
            <partial name="_FuelTable" model="Model.Entries" view-data='new ViewDataDictionary(ViewData) { ["ShowVehicle"] = Model.VehicleId is null }' />
        </div>
    }
</div>

@section Scripts {
    @if (Model.Entries.Count > 0) { <partial name="_DataTableScripts" /> }
}
