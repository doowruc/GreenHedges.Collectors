@model IEnumerable<FuelEntryView>
@{
    var showVehicle = ViewData["ShowVehicle"] as bool? ?? false;
    // Sort values for cells whose text doesn't sort as-is, for DataTables (see _DataTableScripts).
    static string Sort(decimal? d) => d?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    // Fill-ups repeated invisibly in the footer so the columns are as wide as they'll ever need to be. Otherwise
    // they resize with whichever rows are on the page (paging, searching), and a page with several of these
    // tables (one per fuel type on a station's page) passes all their fill-ups in "SizeColumnsFrom" so they all
    // match. For the figures, the one with the most characters in each column (digits are all the same width,
    // site.css; an icon counts as two); for the names, one per distinct name, as letters' widths vary.
    var sizeFrom = (ViewData["SizeColumnsFrom"] as IEnumerable<FuelEntryView> ?? Model).ToList();
    static int Len(object? value) => value?.ToString()?.Length ?? 0;
    var columnText = new List<Func<FuelEntryView, int>>
    {
        f => Len(f.Litres.ToString("0.00")),
        f => Len(f.EffectiveCostPerLitre.ToString("0.000")) + (f.VoucherPerLitre is > 0 ? 2 : 0),
        f => Len(f.TotalCost.ToString("C")),
        f => Len(f.TripMiles?.ToString("0.0")),
        f => Len(f.TripAverageMpg?.ToString("0.0")),
        f => Len(f.CalculatedMpg?.ToString("0.0")) + (f.MpgDifference is { } d ? Len(d.ToString("+0.0;-0.0;0.0")) + 3 : 0),
        f => Len(f.Range),
        f => Len(f.Odometer?.ToString("N0")),
        f => Len(f.CostPerMile is { } c ? (c * 100).ToString("0.0") : "")
    };
    var widest = sizeFrom.Count == 0 ? [] : columnText.Select(text => sizeFrom.MaxBy(text)!)
        .Concat(sizeFrom.DistinctBy(f => f.FuelStation))
        .Concat(showVehicle ? sizeFrom.DistinctBy(f => f.VehicleName) : [])
        .Distinct().ToList();

    async Task Row(FuelEntryView f)
    {
        var diff = f.MpgDifference;
        <tr>
            <td data-order="@f.Date.ToString("yyyy-MM-dd")">@f.Date.ToString("dd/MM/yyyy")</td>
            @if (showVehicle)
            {
                <td><a asp-page="/Vehicles/Details" asp-route-id="@f.VehicleId">@f.VehicleName</a></td>
            }
            <td>
                @for (var i = 0; i < f.Stops.Count; i++)
                {
                    var s = f.Stops[i];
                    if (i > 0) { <text> + </text> }
                    <a asp-page="/FuelBrands/Stations/Details" asp-route-brandId="@s.BrandId" asp-route-id="@s.StationId" asp-route-fuelType="@f.FuelType">@s.Brand @s.Station</a>
                }
            </td>
            <td class="text-end">@f.Litres.ToString("0.00")</td>
            <td class="text-end" data-order="@Sort(f.EffectiveCostPerLitre)">
                @f.EffectiveCostPerLitre.ToString("0.000")
                @if (f.VoucherPerLitre is > 0) { <i class="bi bi-ticket-perforated text-success" title="@($"Voucher £{f.VoucherPerLitre:0.000}/l off £{f.CostPerLitre:0.000}")"></i> }
            </td>
            <td class="text-end">@f.TotalCost.ToString("C")</td>
            <td class="text-end">@f.TripMiles?.ToString("0.0")</td>
            <td class="text-end">@f.TripAverageMpg?.ToString("0.0")</td>
            <td class="text-end" data-order="@Sort(f.CalculatedMpg)">
                @f.CalculatedMpg?.ToString("0.0")
                @if (diff is { } d)
                {
                    // Shown whenever there's a dash figure to compare, however small; an exact match is muted.
                    <small class="@(d > 0 ? "text-optimistic" : d < 0 ? "text-pessimistic" : "text-body-secondary")" title="Dash minus real">(@d.ToString("+0.0;-0.0;0.0"))</small>
                }
            </td>
            <td class="text-end">@f.Range</td>
            <td class="text-end">@f.Odometer?.ToString("N0")</td>
            <td class="text-end">@(f.CostPerMile is { } c ? (c * 100).ToString("0.0") : "")</td>
            <td class="text-end text-nowrap">
                <a asp-page="/FuelLog/Edit" asp-route-id="@f.Id" class="btn btn-sm btn-link p-0 me-2" title="Edit"><i class="bi bi-pencil"></i></a>
                <a asp-page="/FuelLog/Delete" asp-route-id="@f.Id" class="btn btn-sm btn-link p-0 text-danger" title="Delete"><i class="bi bi-trash"></i></a>
            </td>
        </tr>
    }
}
@* A DataTable when the page includes _DataTableStyles and _DataTableScripts. dt-pending shows only the
   first page of rows until DataTables has loaded, so the table doesn't jump. *@
<div class="data-table dt-pending" data-noun="fill-ups">
<div class="table-responsive">
<table class="table table-sm table-hover table-data align-middle mb-0">
    <thead class="table-head">
        <tr>
            <th>Date</th>
            @if (showVehicle) { <th data-column="vehicle">Vehicle</th> }
            <th>Fuel Station</th>
            <th class="text-end">Litres</th><th class="text-end">£/Litre</th><th class="text-end">Cost</th>
            <th class="text-end">Trip Miles</th><th class="text-end">Dash MPG</th><th class="text-end">Real MPG</th>
            <th class="text-end">Range</th><th class="text-end">Odometer</th><th class="text-end">p/Mile</th><th data-orderable="false" data-searchable="false"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var f in Model) { await Row(f); }
    </tbody>
    @* Invisible and zero height (site.css), but they set the column widths; see "widest" above. *@
    <tfoot class="column-sizer" aria-hidden="true">
    @foreach (var f in widest) { await Row(f); }
    </tfoot>
</table>
</div>
</div>
