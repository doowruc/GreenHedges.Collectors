@*
    "Last 12 months" / "All time" switch. Shows the matching content on the page – mark it up as
    <div class="period-stats" data-period="12m">…</div> and <div class="period-stats" data-period="all">…</div>.
    The selection is remembered across pages in the statsPeriod cookie (see period-toggle.js).
*@
@{
    // Render the selected button server-side so it doesn't visibly switch when the script runs.
    var period = Context.Request.Cookies["statsPeriod"] == "all" ? "all" : "12m";
}
<ul class="nav nav-pills nav-pills-sm mb-2" role="tablist" aria-label="Stats period">
    @foreach (var (value, label) in new[] { ("12m", "Last 12 months"), ("all", "All time") })
    {
        <li class="nav-item">
            <button class="nav-link @(value == period ? "active" : null)" type="button" role="tab"
                    aria-selected="@(value == period ? "true" : "false")" data-show-period="@value">@label</button>
        </li>
    }
</ul>
<script src="~/js/period-toggle.js" asp-append-version="true"></script>
