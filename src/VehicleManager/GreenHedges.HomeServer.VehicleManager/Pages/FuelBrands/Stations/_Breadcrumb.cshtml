@model VehicleManager.Pages.FuelBrands.Stations.StationPageModel
<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a asp-page="/FuelBrands/Index">Fuel Brands</a></li>
        @if (Model.Crumb is null)
        {
            <li class="breadcrumb-item active" aria-current="page">@Model.BrandName</li>
        }
        else
        {
            <li class="breadcrumb-item"><a asp-page="/FuelBrands/Stations/Index" asp-route-brandId="@Model.BrandId">@Model.BrandName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Crumb</li>
        }
    </ol>
</nav>
