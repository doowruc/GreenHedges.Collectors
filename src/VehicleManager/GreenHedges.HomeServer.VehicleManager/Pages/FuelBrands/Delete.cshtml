@page "{id:int}"
@model VehicleManager.Pages.FuelBrands.DeleteModel
@{ ViewData["Title"] = "Delete fuel brand"; }

<h1 class="h3 mb-3">Delete fuel brand</h1>
<div class="card shadow-sm border-danger"><div class="card-body">
    @if (Model.Brand.InUse)
    {
        <p><strong>@Model.Brand.Name</strong> can't be deleted because it has @Model.Brand.Stations station(s).
           To get rid of a duplicate, merge it into the right fuel brand instead.</p>
        <a asp-page="Merge" asp-route-id="@Model.Brand.Id" class="btn btn-primary">Merge</a>
        <a asp-page="Stations/Index" asp-route-brandId="@Model.Brand.Id" class="btn btn-outline-secondary">Stations</a>
        <a asp-page="Index" class="btn btn-outline-secondary">Back</a>
    }
    else
    {
        <p>Are you sure you want to delete <strong>@Model.Brand.Name</strong>?</p>
        <form method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
</div></div>
