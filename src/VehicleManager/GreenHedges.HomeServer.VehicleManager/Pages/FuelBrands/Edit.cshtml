@page "{id:int}"
@model GreenHedges.HomeServer.VehicleManager.Pages.FuelBrands.EditModel
@{ ViewData["Title"] = "Edit fuel brand"; }

<h1 class="h3 mb-3">Edit fuel brand</h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Place.RowVersion" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Place.Name" class="form-label"></label>
                <input asp-for="Place.Name" class="form-control" maxlength="@GreenHedges.HomeServer.VehicleManager.Models.FuelBrand.MaxNameLength" autofocus />
                <span asp-validation-for="Place.Name" class="text-danger small"></span>
            </div>
        </div>
        <p class="form-text">Every fill-up at its stations shows the new name.</p>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
