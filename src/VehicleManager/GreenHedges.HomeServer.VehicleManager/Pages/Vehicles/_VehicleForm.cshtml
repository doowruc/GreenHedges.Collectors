@model Vehicle
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<VehicleType>()" class="form-select"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="Make" class="form-label"></label>
        <input asp-for="Make" class="form-control" placeholder="e.g. Mercedes" />
        <span asp-validation-for="Make" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" placeholder="e.g. A-Class" />
        <span asp-validation-for="Model" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="RegistrationNumber" class="form-label"></label>
        <input asp-for="RegistrationNumber" class="form-control text-uppercase" placeholder="AB12 CDE" />
        <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="RegistrationDate" class="form-label"></label>
        <input asp-for="RegistrationDate" class="form-control" />
        <span asp-validation-for="RegistrationDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="PurchasedDate" class="form-label"></label>
        <input asp-for="PurchasedDate" class="form-control" />
        <span asp-validation-for="PurchasedDate" class="text-danger small"></span>
    </div>
</div>
