@page "{id:int}"
@model VehicleManager.Pages.Vehicles.EditModel
@{ ViewData["Title"] = "Edit vehicle"; }

<h1 class="h3 mb-3">Edit @Model.Vehicle.DisplayName</h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        @* Not in the form partial: its "for" prefix would hide page-level errors, e.g. an edit conflict. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_VehicleForm" for="Vehicle" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Details" asp-route-id="@RouteData.Values["id"]" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
