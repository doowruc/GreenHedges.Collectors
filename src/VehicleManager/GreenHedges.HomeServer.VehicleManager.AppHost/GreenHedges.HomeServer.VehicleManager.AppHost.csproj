<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <!-- Local development only: runs the app with the Aspire dashboard (logs, traces, metrics). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The dashboard and orchestrator come from NuGet rather than the Aspire CLI's bundle, so `aspire run` and
         `dotnet run` work whichever CLI version is installed. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- A security pin for a transitive package: see Directory.Packages.props. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GreenHedges.HomeServer.VehicleManager\GreenHedges.HomeServer.VehicleManager.csproj" />
  </ItemGroup>

</Project>
